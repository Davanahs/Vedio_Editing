# ========================================================
# ClipForge / Reel Editor AI Studio — Environment Configuration
# ========================================================

# --------------------------------------------------------
# AI PROVIDERS (At least one provider is recommended)
# --------------------------------------------------------
# 1. Groq Cloud (Recommended for ultra-fast Whisper transcription: ~4.8s for 48s audio)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. OpenRouter (Multi-model LLM Director fallback: Nemotron, Gemma, Llama, etc.)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# 3. Google Gemini (Native AI Director: gemini-2.0-flash / gemini-1.5-flash)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# --------------------------------------------------------
# LOCAL AI FALLBACK (Optional)
# --------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --------------------------------------------------------
# STUDIO SERVER & PROCESSING CONFIGURATION
# --------------------------------------------------------
STUDIO_HOST=127.0.0.1
STUDIO_PORT=5050
MAX_PARALLEL_JOBS=2

# Default target resolution for video previews (540x960 for 9:16 vertical, 960x540 for 16:9)
PREVIEW_WIDTH=540
PREVIEW_HEIGHT=960

# --------------------------------------------------------
# DIRECTORY PATHS (Relative to project root or absolute)
# --------------------------------------------------------
RAW_FOOTAGE_DIR=./Raw Footage
EXPORT_DIR=./Export
SFX_DIR=./assets/sfx
LOGO_DIR=./assets/cache/logos
TEMP_DIR=./engine/temp

# --------------------------------------------------------
# DATABASE & CACHE (Optional for distributed queue mode)
# --------------------------------------------------------
DATABASE_URL=postgresql://reeluser:reelpass@localhost:5432/reeldb
REDIS_URL=redis://localhost:6379/0
